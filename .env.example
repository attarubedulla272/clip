NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://mongo:27017/clipforge
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false
MAX_UPLOAD_BYTES=2147483648
MAX_VIDEO_DURATION_SECONDS=3600
UPLOAD_CHUNK_BYTES=8388608
MIN_FREE_DISK_BYTES=268435456
WHISPER_MODEL_SIZE=base
WHISPER_CHUNK_SECONDS=30
MAX_CONCURRENT_JOBS_PER_USER=1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WHISPER_VENV=/opt/whisper-venv
STORAGE_ROOT=/app/data
LOCAL_UID=1000
LOCAL_GID=1000
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://host.docker.internal:11434
FASTEMBED_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FASTEMBED_CACHE_DIR=/models/fastembed
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
LLM_PROVIDER_ORDER=gemini,ollama,offline
METADATA_PROVIDER_TIMEOUT_MS=15000
METADATA_OLLAMA_PROBE_TIMEOUT_MS=800
TREND_NETWORK_TIMEOUT_MS=5000
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=IN
YOUTUBE_RELEVANCE_LANGUAGE=en
YOUTUBE_DAILY_QUOTA_BUDGET=10000
YOUTUBE_QUOTA_SAFETY_STOP_FRACTION=0.8
# Current YouTube Data API unit costs; keep configurable and per Google's official quota docs
YOUTUBE_SEARCH_LIST_COST=100
YOUTUBE_VIDEOS_LIST_COST=1
